# Supabase Project Settings → API. These values are server-side in this app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase secret/service-role key. Server-only; never add to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key

# Optional paid 30-day OutfitAI Plus pass (₹149; not an auto-renewing subscription).
# Create the Razorpay account, apply migration 002, add the two secret keys in Render,
# then set OUTFITAI_BILLING_ENABLED=true. Keep all payment secrets server-side.
OUTFITAI_BILLING_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_server_only_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_server_only_webhook_secret

